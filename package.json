{
	"name": "veighnsche",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build:ts": "swc src --out-dir dist --copy-files",
		"build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
		"build:html": "node dist/scripts/build-html.js",
		"build": "pnpm run build:ts && pnpm run build:css && pnpm run build:html",
		"watch:ts": "nodemon --watch src --ext ts,tsx --exec \"pnpm run build:ts && node dist/scripts/build-html.js\"",
		"watch:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --watch",
		"dev": "concurrently -n \"TAILWIND,SWC+HTML,WRANGLER\" -c \"cyan,green,magenta\" \"pnpm run watch:css\" \"pnpm run watch:ts\" \"wrangler dev\"",
		"deploy": "pnpm run build && wrangler deploy"
	},
	"devDependencies": {
		"@swc/cli": "^0.7.3",
		"@swc/core": "^1.11.21",
		"@types/node": "^22.14.1",
		"@typescript-eslint/eslint-plugin": "^8.31.0",
		"@typescript-eslint/parser": "^8.31.0",
		"autoprefixer": "^10.4.21",
		"concurrently": "^9.1.2",
		"eslint": "^9.25.1",
		"eslint-config-prettier": "^10.1.2",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.2.6",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"nodemon": "^3.1.10",
		"postcss": "^8.5.3",
		"preact": "^10.26.5",
		"preact-render-to-string": "^6.5.13",
		"prettier": "^3.5.3",
		"tailwindcss": "^4.1.4",
		"typescript": "^5.8.3",
		"wrangler": "^4.12.1"
	}
}
